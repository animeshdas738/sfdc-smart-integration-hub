    <label>Webhook Log</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Webhook_Endpoint__c</columns>
        <columns>Status__c</columns>
        <columns>Received_At__c</columns>
        <columns>Processed_At__c</columns>
        <columns>Error_Code__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <listViews>
        <fullName>Failed_Webhooks</fullName>
        <columns>NAME</columns>
        <columns>Webhook_Endpoint__c</columns>
        <columns>Error_Code__c</columns>
        <columns>Received_At__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Status__c</field>
            <operation>equals</operation>
            <value>Failed</value>
        </filters>
        <label>Failed Webhooks</label>
    </listViews>
    <listViews>
        <fullName>Recent_Webhooks</fullName>
        <columns>NAME</columns>
        <columns>Webhook_Endpoint__c</columns>
        <columns>Status__c</columns>
        <columns>Received_At__c</columns>
        <columns>Processing_Duration_Ms__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Received_At__c</field>
            <operation>greaterOrEqual</operation>
            <value>LAST_N_DAYS:7</value>
        </filters>
        <label>Recent Webhooks</label>
    </listViews>
    <nameField>
        <displayFormat>WH-{00000000}</displayFormat>
        <label>Webhook Log Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Webhook Logs</pluralLabel>
    <recordTypeTrackHistory>false</recordTypeTrackHistory>
